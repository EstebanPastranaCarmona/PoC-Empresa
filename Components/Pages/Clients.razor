@page "/clients"
@page "/"

@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using PoCEmPRESA.Data
@using PoCEmPRESA.Models

@inject AppDbContext Db

<PageTitle>Clientes</PageTitle>

<EditForm Model="newClient" OnValidSubmit="AddClient">

    <DataAnnotationsValidator />

    <div>
        <label>Nombre:</label>
        <InputText @bind-Value="newClient.Name" />
        <ValidationMessage For="@(() => newClient.Name)" />
    </div>

    <div>
        <label>Correo:</label>
        <InputText @bind-Value="newClient.Email" />
        <ValidationMessage For="@(() => newClient.Email)" />
    </div>

    <button type="submit">Agregar</button>

</EditForm>


@if (editingClient is Client clientToEdit)
{
    <hr />

    <h2>Editar cliente</h2>

    <EditForm Model="clientToEdit" OnValidSubmit="SaveEdition">

        <DataAnnotationsValidator />

        <div>
            <label>Nombre:</label>
            <InputText @bind-Value="clientToEdit.Name" />
            <ValidationMessage For="@(() => clientToEdit.Name)" />
        </div>

        <div>
            <label>Correo:</label>
            <InputText @bind-Value="clientToEdit.Email" />
            <ValidationMessage For="@(() => clientToEdit.Email)" />
        </div>

        <button type="submit">Guardar cambios</button>

        <button type="button" @onclick="CancelEdition">
            Cancelar
        </button>

    </EditForm>
}


@if (clients == null)
{
    <p>Cargando...</p>
}
else if (clients.Count == 0)
{
    <p>No hay clientes registrados.</p>
}
else
{
    <table>

        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var client in clients)
            {
                <tr>

                    <td>@client.Id</td>
                    <td>@client.Name</td>
                    <td>@client.Email</td>

                    <td>
                        <button type="button"
                                @onclick="() => EditClient(client)">
                            Editar
                        </button>

                        <button type="button"
                                @onclick="() => DeleteClient(client.Id)">
                            Eliminar
                        </button>
                    </td>

                </tr>
            }

        </tbody>

    </table>
}


@code {

    private List<Client>? clients;

    private Client newClient = new Client();

    private Client? editingClient;


    protected override async Task OnInitializedAsync()
    {
        clients = await Db.Clients.ToListAsync();
    }


    private async Task AddClient()
    {
        Db.Clients.Add(newClient);

        await Db.SaveChangesAsync();

        clients = await Db.Clients.ToListAsync();

        newClient = new Client();
    }


    private async Task SaveEdition()
    {
        if (editingClient == null)
        {
            return;
        }

        var client = await Db.Clients.FindAsync(editingClient.Id);

        if (client == null)
        {
            return;
        }

        client.Name = editingClient.Name;
        client.Email = editingClient.Email;

        await Db.SaveChangesAsync();

        clients = await Db.Clients.ToListAsync();

        editingClient = null;
    }


    private async Task DeleteClient(int id)
    {
        var client = await Db.Clients.FindAsync(id);

        if (client == null)
        {
            return;
        }

        Db.Clients.Remove(client);

        await Db.SaveChangesAsync();

        clients = await Db.Clients.ToListAsync();
    }


    private void CancelEdition()
    {
        editingClient = null;
    }


    private void EditClient(Client client)
    {
        editingClient = new Client
        {
            Id = client.Id,
            Name = client.Name,
            Email = client.Email
        };
    }

}